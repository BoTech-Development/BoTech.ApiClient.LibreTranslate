<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>1.1.0</Version>
    <Title>BoTech.ApiClient.LibreTranslate</Title>
    <Authors>www.botech.dev</Authors>
    <Description>A .net api client for https://LibreTranslate.com</Description>
    <PackageProjectUrl>https://github.com/BoTech-Development/BoTech.ApiClient.LibreTranslate</PackageProjectUrl>
    <PackageIcon>BoTechLogoSmall.drawio.png</PackageIcon>
    <RepositoryUrl>https://github.com/BoTech-Development/BoTech.ApiClient.LibreTranslate</RepositoryUrl>
    <PackageTags>Client LibreTranslate Translate</PackageTags>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BoTech.HttpClientHelper" Version="1.0.7-Alpha" />
  </ItemGroup>

  <ItemGroup>
    <None Update="BoTechLogoSmall.drawio.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\LICENSE.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
